{
  "name": "couchkey",
  "version": "0.1.0",
  "description": "Control your Xbox from any keyboard or phone on your Wi-Fi. Local, open source, no extra hardware.",
  "keywords": [
    "xbox",
    "xbox-series-x",
    "xbox-one",
    "smartglass",
    "remote-control",
    "keyboard",
    "lan",
    "websocket",
    "homelab"
  ],
  "homepage": "https://github.com/Vyashubham/couchkey#readme",
  "bugs": {
    "url": "https://github.com/Vyashubham/couchkey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vyashubham/couchkey.git"
  },
  "license": "MIT",
  "author": "Shubham Vyas",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.16.0",
    "xbox-smartglass-core-node": "^0.6.10"
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  }
}
