{
  "name": "couchkey",
  "version": "0.1.0",
  "description": "Control your Xbox from any keyboard or phone on your Wi-Fi. Local, open source, no extra hardware.",
  "keywords": [
    "xbox",
    "xbox-series-x",
    "xbox-one",
    "smartglass",
    "remote-control",
    "keyboard",
    "lan",
    "websocket",
    "homelab"
  ],
  "homepage": "https://github.com/Vyashubham/couchkey#readme",
  "bugs": {
    "url": "https://github.com/Vyashubham/couchkey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vyashubham/couchkey.git"
  },
  "license": "MIT",
  "author": "Shubham Vyas",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run coverage"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ws": "^8.16.0",
    "xbox-smartglass-core-node": "^0.6.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "public",
    "layouts"
  ]
}
