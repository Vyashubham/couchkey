{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "browser": false
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-console": "off",
    "eqeqeq": ["error", "smart"],
    "prefer-const": "warn",
    "no-var": "warn",
    "semi": ["error", "always"]
  },
  "overrides": [
    {
      "files": ["public/**/*.js"],
      "env": { "browser": true, "node": false }
    }
  ]
}
