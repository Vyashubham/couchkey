# Copy to .env and edit. `npm start` loads .env automatically if it exists.
# Every value below is the default; delete any line you don't need to change.

# --- Server ------------------------------------------------------------
# Port for the web GUI and WebSocket.
PORT=3247

# --- Input -------------------------------------------------------------
# Minimum gap between gamepad presses, in ms. Lower = faster typing on
# app keyboards, but the Xbox may drop presses if it's too low.
BUTTON_MIN_INTERVAL_MS=150
# Ask the Xbox to confirm every press (experimental). 1 = on.
GAMEPAD_ACK=0
# How long a button is held before release when GAMEPAD_ACK=1, in ms.
GAMEPAD_HOLD_MS=60
# How long to wait for the Xbox to confirm a press, in ms.
GAMEPAD_ACK_TIMEOUT_MS=1000

# --- Connection --------------------------------------------------------
# Wait before reconnecting after the connection drops, in ms.
RECONNECT_DELAY_MS=5000
# Give up on a connect attempt if the Xbox doesn't answer within this many ms.
CONNECT_TIMEOUT_MS=10000
# Seconds of silence from the Xbox before the connection is considered dead.
HEARTBEAT_TIMEOUT_SEC=30
# Start sending keep-alives after this many seconds of silence.
HEARTBEAT_KEEPALIVE_AFTER_SEC=3
# Re-send keep-alives every N seconds while silent.
HEARTBEAT_KEEPALIVE_INTERVAL_SEC=2

# --- Data ---------------------------------------------------------------
# Where Couchkey remembers consoles (default: data/ in the project folder).
# DATA_DIR=/path/to/data
# Reconnect to the last Xbox automatically on startup. 0 = off.
AUTO_CONNECT=1

# --- Logging -----------------------------------------------------------
# Where session logs are written (default: logs/ in the project folder).
# LOG_DIR=/path/to/logs
# SmartGlass library debug output in the terminal. 0 = off.
SMARTGLASS_DEBUG=1
